{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AccountDatabase": ""
  },
  "Jwt": {
    "Authority": "http://localhost:8081",
    "Issuer": "peaker-auth",
    "Audience": "peaker-api",
    "RequireHttpsMetadata": false
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "AuthTokenKey": "",
    "Folder": "peaker/dev/avatars"
  },
  "AvatarSweep": {
    "Enabled": true,
    "Interval": "24:00:00",
    "Retention": "24:00:00"
  },
  "PeakCatalog": {
    "BaseAddress": "http://localhost:8083/",
    "RequestTimeout": "00:00:03"
  },
  "Messaging": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Outbox": {
    "PollingInterval": "00:00:10",
    "BatchSize": 20,
    "MaxAttempts": 12,
    "RetryBackoffBase": "00:00:30",
    "RetryBackoffCap": "00:15:00",
    "PendingAgeThreshold": "00:05:00"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
